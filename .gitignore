# Code/asset split (see archive/README.md).
# Git tracks only "imperatives": sources, scripts, markdown instructions.
# Everything git ignores here is an asset and goes to Google Drive
# via archive/push_assets.sh -- except the junk listed in archive/never_upload.txt.

# 1. Ignore everything ...
*
# 2. ... but descend into directories ...
!*/
# 3. ... and track code by extension.
!.gitignore
!*.md
!*.py
!*.sh
!*.tex
!*.bib
!*.sty
!*.cls
!*.yaml
!*.yml
!archive/*.txt

# 4. Build outputs are regenerable; treat them as assets even if they look like code.
build/
writeup/build/

# BEGIN markdown images (managed by archive/track_md_images.py)
!/docs/readme/lev.gif
!/docs/readme/pitch_vs_static.png
!/docs/readme/pod.png
!/docs/readme/regimes.png
!/docs/readme/slide_example.png
!/figs/flightRegimeMap.png
!/figs/guptaSpanwiseInstability.png
!/figs/mesh_bl.png
!/figs/mesh_figure.png
!/figs/mesh_le.png
!/figs/mesh_near.png
!/figs/mesh_overview.png
!/figs/mesh_te.png
!/figs/mesh_te_base.png
!/figs/pitch_plot_tobedigitized.png
!/figs/williamsonModeAB.png
!/figs/williamsonModeC.png
!/slides_mds/OpenFOAM_logo.svg
# END markdown images
